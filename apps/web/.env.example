# Environment variables example
# Copy this file to .env.local and update the values as needed

# Node
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com

# Server
DATABASE_URL="postgresql://argocut:argocut@localhost:5432/argocut"
BETTER_AUTH_SECRET=your_better_auth_secret

UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=example_token

MARBLE_WORKSPACE_KEY=your_workspace_key_here

FREESOUND_CLIENT_ID=your_client_id_here
FREESOUND_API_KEY=your_api_key_here

# Set to 1 to expose window.__argocutAgent for the agent MCP server. Never enable in production.
NEXT_PUBLIC_ARGOCUT_AGENT_API=0

# Set to 1 to load the React Scan render profiler in development.
# It draws outlines around re-rendering components — leave off while editing.
NEXT_PUBLIC_REACT_SCAN=0

# Where projects and media live.
#   local  - the browser profile (IndexedDB + OPFS). Per-browser, not shareable.
#   server - Postgres for documents, disk for media. One database, every window.
NEXT_PUBLIC_STORAGE_MODE=server

# Which store answers /api/storage/doc/*. Postgres is the default; `files` reads
# documents written by the old filesystem store, which is how you migrate them.
# ARGOCUT_DOC_STORE=postgres

# Media binaries and blobs. Defaults to ~/ArgoCut/data.
# ARGOCUT_DATA_DIR=/var/lib/argocut/data

# Host port for the Postgres container. Override when something already holds
# 5432 on this machine — a host Postgres binds 127.0.0.1 and silently wins over
# Docker's bind, so the app connects to the wrong database.
# ARGOCUT_DB_PORT=5434
