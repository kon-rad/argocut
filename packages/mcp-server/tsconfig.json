{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["esnext", "dom"],
		"types": ["bun"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts"]
}
